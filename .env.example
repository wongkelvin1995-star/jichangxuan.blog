# ===== 站点环境 =====
# 不设置或 production：正式站，允许索引
# preview：预览/测试站，全站 noindex；robots.txt 仍允许抓取（爬虫要能读到 noindex）且不声明 sitemap（不要把预览构建部署到正式域名）
NEXT_PUBLIC_SITE_ENV=production

# 规范域名（不含结尾斜杠）。canonical、sitemap、JSON-LD 与 IndexNow 都以它为准
NEXT_PUBLIC_SITE_URL=https://jichangxuan.blog

# ===== 联系与纠错 =====
# 显示在 /contact/ 与页脚的联系邮箱。留空时联系页显示“纠错邮箱正在开通”，不显示回复时限承诺
NEXT_PUBLIC_CONTACT_EMAIL=

# ===== Bing Webmaster Tools =====
# 在 Bing 站长工具获取的 msvalidate.01 验证码，留空则不输出验证标签
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# ===== IndexNow =====
# 8–128 位字母、数字或连字符。构建前脚本会生成 public/<key>.txt；
# scripts/indexnow.mjs 只在该文件已在线上可访问时才真正提交
INDEXNOW_KEY=

# ===== 构建模式 =====
# 1：纯静态导出到 out/（Cloudflare Pages 等静态托管）。Cloudflare Pages 自带 CF_PAGES 变量时自动启用
# STATIC_EXPORT=
